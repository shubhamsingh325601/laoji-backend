# --- Server ---
PORT=3000
NODE_ENV=development
# laoji-admin (browser) is the only cross-origin client — RN apps aren't
# subject to CORS. Comma-separated for multiple origins.
CORS_ORIGIN=http://localhost:8080

# --- Database (Postgres + Drizzle) ---
# DATABASE_URL is what the running app connects as at runtime — least-
# privilege role (SELECT/INSERT/UPDATE/DELETE only, no DDL), created by
# scripts/init-db/01-create-app-role.sql. Never point this at the owner role.
DATABASE_URL=postgres://laoji_app:laoji_app@localhost:5433/laoji_dev
# MIGRATIONS_DATABASE_URL is the schema-owner role — only drizzle-kit
# (db:generate/db:migrate) and one-off admin scripts (seed:admin) use this;
# it's never read by the running NestJS app.
MIGRATIONS_DATABASE_URL=postgres://laoji:laoji@localhost:5433/laoji_dev

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Admin auth ---
# Assumption (per implementation plan Phase 1): Admin uses email+password, not phone+OTP.
# Flagged for confirmation before Phase 1 auth is built.

# --- Cloudinary (signed uploads only — never expose CLOUDINARY_API_SECRET client-side) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Firebase Cloud Messaging (push) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Resend (email) ---
RESEND_API_KEY=

# --- Payments ---
# Only "upi_deeplink" is implemented at MVP. Never call UPI logic directly from
# Order/Checkout code — always go through the PaymentProvider interface.
PAYMENT_PROVIDER=upi_deeplink
UPI_VPA=laoji@upi
UPI_PAYEE_NAME=Laoji

# --- Google Maps (Geocoding API only — address lookup, NOT Directions/Distance-Matrix) ---
GOOGLE_MAPS_API_KEY=
